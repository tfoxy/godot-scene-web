# multi-MB generated atlas page. Never commit any of it.
artifacts/perf/
*.tsbuildinfo
__pycache__/
*.import
*.uid

# Roboto fixture fonts are downloaded on demand (scripts/ensure-roboto-fonts.ts)
fixtures/assets/fonts/roboto/

# The CJK benchmark font is downloaded and subset on demand (scripts/ensure-cjk-font.ts): the
# 17.7 MB upstream variable TTF and the ~800 KB subset it is instanced into.
fixtures/assets/fonts/noto-sans-sc/

# The MSDF fixture variant is the ONE font .import that is committed, and the exception is
# deliberate: `*.import` above is ignored because every other one is Godot's importer DEFAULTS,
# regenerated by `--import` on any checkout. This one states a bundle the importer would never
# produce (multichannel_signed_distance_field on, msdf_pixel_range 24), which is what makes the
# text-fidelity crossover sweep reproducible without the sibling game repo. Its TTF beside it is
# still the on-demand subset and stays ignored, like every other font here.
fixtures/assets/fonts/roboto-msdf/*.ttf
!fixtures/assets/fonts/roboto-msdf/*.ttf.import

# Playground particle-verify harness: a machine-local symlink to an external Godot
# project (recreate per scripts/serve note); never committed or linted.
apps/playground/public/recovered
