enable_testing()
if(GRC_WINDOWS)
  set(GRC_PLATFORM_SOURCE src/rs_platform_win32.cpp)
else()
  find_package(Threads REQUIRED)
  set(GRC_PLATFORM_SOURCE src/rs_platform_posix.cpp)
endif()
add_library(grc_platform STATIC ${GRC_PLATFORM_SOURCE})
if(GRC_WINDOWS)
  target_include_directories(grc_platform PUBLIC src)
  target_compile_definitions(grc_platform PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0A00 PSAPI_VERSION=2)
  target_link_libraries(grc_platform PRIVATE grc_warnings PUBLIC ws2_32 bcrypt advapi32)
else()
  set_target_properties(grc_platform PROPERTIES
    POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
  target_include_directories(grc_platform PUBLIC src)
  target_link_libraries(grc_platform PRIVATE grc_warnings PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
endif()
add_executable(rs_platform_clock_test test/rs_platform_clock_test.cpp)
target_link_libraries(rs_platform_clock_test PRIVATE grc_warnings grc_platform)
if(NOT GRC_WINDOWS)
  target_link_options(rs_platform_clock_test PRIVATE -Wl,--wrap=clock_gettime)
endif()
grc_add_test(NAME rs_platform_clock COMMAND rs_platform_clock_test)

add_executable(rs_platform_test test/rs_platform_test.cpp)
target_link_libraries(rs_platform_test PRIVATE grc_warnings grc_platform)
if(GRC_WINDOWS)
  target_link_libraries(rs_platform_test PRIVATE grc_static_runtime)
  target_compile_definitions(rs_platform_test PRIVATE GRC_TEST_TMP_DIR="rs_platform_test_tmp")
else()
  target_compile_definitions(rs_platform_test PRIVATE
    GRC_TEST_TMP_DIR="${CMAKE_CURRENT_BINARY_DIR}/rs_platform_test_tmp")
endif()
grc_add_test(NAME rs_platform COMMAND rs_platform_test)

add_executable(rs_platform_paths_test test/rs_platform_paths_test.cpp
  src/rs_texture_cache.cpp src/rs_sha256.cpp)
target_link_libraries(rs_platform_paths_test PRIVATE grc_warnings grc_platform)
if(GRC_WINDOWS)
  target_link_libraries(rs_platform_paths_test PRIVATE grc_static_runtime)
  target_compile_definitions(rs_platform_paths_test PRIVATE GRC_TEST_TMP_DIR="rs_platform_paths_test_tmp")
  grc_add_test(NAME rs_platform_paths_narrow_path_sabotage
    COMMAND rs_platform_paths_test --expect-fail non-ascii)
  set_tests_properties(rs_platform_paths_narrow_path_sabotage PROPERTIES ENVIRONMENT GRC_PLATFORM_FAULT=narrow-path)
  grc_add_test(NAME rs_platform_paths_plain_rename_sabotage
    COMMAND rs_platform_paths_test --expect-fail replace-twice)
  set_tests_properties(rs_platform_paths_plain_rename_sabotage PROPERTIES ENVIRONMENT GRC_PLATFORM_FAULT=plain-rename)
else()
  target_compile_definitions(rs_platform_paths_test PRIVATE
    GRC_TEST_TMP_DIR="${CMAKE_CURRENT_BINARY_DIR}/rs_platform_paths_test_tmp")
endif()
grc_add_test(NAME rs_platform_paths COMMAND rs_platform_paths_test)

add_executable(abi_convention_probe test/abi_convention_probe.cpp)
add_executable(abi_convention_probe_msvc_order test/abi_convention_probe.cpp)
target_compile_definitions(abi_convention_probe_msvc_order PRIVATE GRC_PROBE_MSVC_ORDER=1)
foreach(probe IN ITEMS abi_convention_probe abi_convention_probe_msvc_order)
  target_include_directories(${probe} PRIVATE src)
  target_compile_options(${probe} PRIVATE -O2)
  target_link_libraries(${probe} PRIVATE grc_warnings)
  if(GRC_WINDOWS)
    target_link_libraries(${probe} PRIVATE grc_static_runtime)
  endif()
endforeach()
grc_add_test(NAME abi_convention_probe COMMAND abi_convention_probe)
grc_add_test(NAME abi_convention_probe_sabotage
  COMMAND abi_convention_probe_msvc_order --expect-fail hook-color,hook-xform)
