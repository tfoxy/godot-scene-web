# Turns the gsw-input reference injector
# (packages/input/godot/addons/gsw_input/*.gd) plus the capture's glue (src/track_inject_glue.gd)
# into ONE GDScript source for GDScript.new() + source_code + reload(), and a header that embeds
# it. Run as `cmake -P` by an add_custom_command (CMakeLists.txt).
#
# Why one script: the addon's eight scripts name each other by `class_name` with no preload, and
# a dynamically created script cannot see a class_name that is not a project global class, while
# one whose class_name matches a project's own global class fails with "hides a global script
# class". So each addon file becomes an INNER CLASS of the glue script (inner classes see their
# siblings by name), and every Gsw{Input,Joypad}* identifier is renamed to RsBuiltin{Input,Joypad}*
# so nothing collides with a project that ships the addon itself. The project's copy is untouched.
#
# Inputs (-D): ADDON_DIR, GLUE, OUT_DIR. Outputs in OUT_DIR: rs_track_inject_script.gd (the
# composed source, for tests) and rs_track_inject_script.h (the bytes and the addon digest), each
# written only when its content changed so an unchanged addon rebuilds nothing.
cmake_minimum_required(VERSION 3.20)

file(GLOB addon_files "${ADDON_DIR}/*.gd")
list(SORT addon_files)
list(LENGTH addon_files addon_count)
if(addon_count EQUAL 0)
  message(FATAL_ERROR "embed_gsw_input: no *.gd under ${ADDON_DIR}")
endif()

file(READ "${GLUE}" glue)
set(all "")
set(inner "")
foreach(f IN LISTS addon_files)
  file(READ "${f}" src)
  string(APPEND all "${src}")
  # Every addon file starts `class_name X` / `extends Y`.
  string(REGEX MATCH "^class_name ([A-Za-z0-9_]+)\nextends ([A-Za-z0-9_]+)\n" head "${src}")
  if(head STREQUAL "")
    message(FATAL_ERROR "embed_gsw_input: ${f} does not start with class_name/extends")
  endif()
  set(cname "${CMAKE_MATCH_1}")
  set(base "${CMAKE_MATCH_2}")
  string(LENGTH "${head}" head_len)
  string(SUBSTRING "${src}" ${head_len} -1 body)
  if(body MATCHES "\"\"\"")
    message(FATAL_ERROR "embed_gsw_input: ${f} has a triple-quoted string, which indenting would change")
  endif()
  string(REGEX REPLACE "Gsw(Input|Joypad)([A-Za-z0-9_]*)" "RsBuiltin\\1\\2" body "${body}")
  string(REGEX REPLACE "Gsw(Input|Joypad)([A-Za-z0-9_]*)" "RsBuiltin\\1\\2" cname "${cname}")
  string(REPLACE "\n" "\n\t" body "${body}")
  string(APPEND inner "\n\nclass ${cname} extends ${base}:\n\t${body}\n")
endforeach()

string(SHA256 addon_sha "${all}")
string(REPLACE "@@ADDON_SHA256@@" "${addon_sha}" glue "${glue}")
set(script "${glue}${inner}")

file(MAKE_DIRECTORY "${OUT_DIR}")
function(write_if_changed path content)
  set(tmp "${path}.tmp")
  file(WRITE "${tmp}" "${content}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${tmp}" "${path}")
  file(REMOVE "${tmp}")
endfunction()

write_if_changed("${OUT_DIR}/rs_track_inject_script.gd" "${script}")

file(READ "${OUT_DIR}/rs_track_inject_script.gd" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){24}" "\\0\n" bytes "${bytes}")
set(header "// Generated by cmake/embed_gsw_input.cmake from packages/input/godot/addons/gsw_input and
// src/track_inject_glue.gd. Do not edit.
#ifndef GRC_RS_TRACK_INJECT_SCRIPT_H
#define GRC_RS_TRACK_INJECT_SCRIPT_H

namespace grc {
namespace live {

// SHA-256 (lowercase hex) of the addon's *.gd files, concatenated in file-name order.
inline constexpr char kBuiltinInjectAddonSha256[] = \"${addon_sha}\";

// The composed GDScript source (UTF-8, no terminator).
inline constexpr unsigned char kBuiltinInjectScript[] = {
${bytes}
};

}  // namespace live
}  // namespace grc

#endif  // GRC_RS_TRACK_INJECT_SCRIPT_H
")
write_if_changed("${OUT_DIR}/rs_track_inject_script.h" "${header}")
