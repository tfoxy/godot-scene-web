set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(GRC_LLVM_MINGW_ROOT "$ENV{GRC_LLVM_MINGW_ROOT}" CACHE PATH "Pinned llvm-mingw root")
if(NOT EXISTS "${GRC_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
  message(FATAL_ERROR "GRC_LLVM_MINGW_ROOT must name an llvm-mingw toolchain root")
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES GRC_LLVM_MINGW_ROOT)
set(CMAKE_C_COMPILER "${GRC_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${GRC_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${GRC_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${GRC_LLVM_MINGW_ROOT}/bin/llvm-ar" CACHE FILEPATH "Archiver")
set(CMAKE_RANLIB "${GRC_LLVM_MINGW_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "Archive indexer")
set(CMAKE_FIND_ROOT_PATH "${GRC_LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
