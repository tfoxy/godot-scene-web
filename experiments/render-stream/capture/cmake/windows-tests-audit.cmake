cmake_minimum_required(VERSION 3.22)

# Windows fingerprinting reads PE images; Linux uses the POSIX fingerprint implementation.
set(GRC_W_SOURCE_SUBSTITUTIONS
  "src/calib_fingerprint_win32.cpp|src/calib_fingerprint_posix.cpp")
# The Win32 fingerprint source needs the PE parser; the POSIX one reads ELF directly.
set(GRC_W_EXTRA_SOURCES_calib_slot_mask_test src/pe_image.cpp)
# This process-identity self-test exercises the Windows PE implementation only.
set(GRC_W_ONLY_TARGETS calib_pe_self_test)
# Windows platform adapters can need grc_platform even when Linux has no platform calls.
# Its C++ runtime is linked statically so the bundle needs no toolchain DLLs.
set(GRC_W_EXTRA_LIBRARIES grc_platform grc_static_runtime)

include("${GRC_LINUX_LISTS}")

# Evaluate the declarations without creating targets or needing a Windows toolchain.
function(grc_w_test name)
  cmake_parse_arguments(PARSE_ARGV 1 W "" "TARGET" "SOURCES;LIBS;DEFINES;ARGS;ENV;INCLUDES;OPTIONS")
  if(W_UNPARSED_ARGUMENTS OR W_KEYWORDS_MISSING_VALUES OR NOT W_TARGET)
    message(FATAL_ERROR "Invalid grc_w_test arguments for ${name}")
  endif()
  if(NOT W_SOURCES OR W_TARGET IN_LIST GRC_W_TARGETS)
    return()
  endif()
  list(APPEND GRC_W_TARGETS "${W_TARGET}")
  set(GRC_W_TARGETS "${GRC_W_TARGETS}" PARENT_SCOPE)
  set(GRC_W_${W_TARGET}_SOURCES "${W_SOURCES}" PARENT_SCOPE)
  set(GRC_W_${W_TARGET}_COMPILE_DEFINITIONS "${W_DEFINES}" PARENT_SCOPE)
  set(GRC_W_${W_TARGET}_INCLUDE_DIRECTORIES "src;${W_INCLUDES}" PARENT_SCOPE)
  set(GRC_W_${W_TARGET}_LINK_LIBRARIES "grc_warnings;grc_static_runtime;${W_LIBS}" PARENT_SCOPE)
endfunction()
include("${CMAKE_CURRENT_LIST_DIR}/windows-tests.cmake")

# Negative ctests change only the recorded lists, never the declarations on disk.
if(DEFINED GRC_W_AUDIT_FAULT)
  if(GRC_W_AUDIT_FAULT STREQUAL "missing_source")
    list(REMOVE_ITEM GRC_W_rs_adopt_test_SOURCES src/rs_warm.cpp)
  elseif(GRC_W_AUDIT_FAULT STREQUAL "missing_definition")
    list(REMOVE_ITEM GRC_W_rs_adopt_test_COMPILE_DEFINITIONS GRC_ADOPT_TEST)
  elseif(GRC_W_AUDIT_FAULT STREQUAL "extra_source")
    list(APPEND GRC_W_rs_adopt_test_SOURCES src/windows_audit_unexpected.cpp)
  elseif(GRC_W_AUDIT_FAULT STREQUAL "no_declarations")
    set(GRC_W_TARGETS "")
  else()
    message(FATAL_ERROR "Unknown GRC_W_AUDIT_FAULT: ${GRC_W_AUDIT_FAULT}")
  endif()
endif()

set(differences "")
set(audited 0)
foreach(target IN LISTS GRC_W_TARGETS)
  if(NOT target IN_LIST GRC_L_TARGETS)
    if(NOT target IN_LIST GRC_W_ONLY_TARGETS)
      list(APPEND differences "${target}: executable target '${target}' missing on Linux")
    endif()
    continue()
  endif()
  math(EXPR audited "${audited} + 1")
  foreach(property IN ITEMS SOURCES COMPILE_DEFINITIONS INCLUDE_DIRECTORIES LINK_LIBRARIES)
    set(linux "${GRC_L_${target}_${property}}")
    set(windows "${GRC_W_${target}_${property}}")
    if(property STREQUAL "SOURCES")
      foreach(substitution IN LISTS GRC_W_SOURCE_SUBSTITUTIONS)
        string(REPLACE "|" ";" pair "${substitution}")
        list(GET pair 0 windows_source)
        list(GET pair 1 linux_source)
        if(windows_source IN_LIST windows)
          list(REMOVE_ITEM windows "${windows_source}")
          list(APPEND windows "${linux_source}")
        endif()
      endforeach()
      foreach(source IN LISTS GRC_W_EXTRA_SOURCES_${target})
        if(NOT source IN_LIST linux)
          list(REMOVE_ITEM windows "${source}")
        endif()
      endforeach()
    elseif(property STREQUAL "COMPILE_DEFINITIONS")
      # The bundle uses relative golden paths; Linux tests use the same directories absolutely.
      foreach(side IN ITEMS linux windows)
        list(TRANSFORM ${side} REPLACE "^(GRC_GOLDEN[0-9]+_DIR)=\".*(protocol/golden-[0-9]+)\"$" "\\1=\"\\2\"")
      endforeach()
    elseif(property STREQUAL "INCLUDE_DIRECTORIES")
      set(relative "")
      foreach(path IN LISTS linux)
        file(RELATIVE_PATH path "${GRC_L_SOURCE_DIR}" "${path}")
        list(APPEND relative "${path}")
      endforeach()
      set(linux "${relative}")
      # Linux gets src directly or through grc_codecs; grc_w_test always adds it on Windows.
      list(REMOVE_ITEM linux src)
      list(REMOVE_ITEM windows src)
    elseif(property STREQUAL "LINK_LIBRARIES")
      list(REMOVE_ITEM linux grc_warnings)
      list(REMOVE_ITEM windows grc_warnings)
      foreach(library IN LISTS GRC_W_EXTRA_LIBRARIES)
        if(NOT library IN_LIST linux)
          list(REMOVE_ITEM windows "${library}")
        endif()
      endforeach()
    endif()
    foreach(side IN ITEMS linux windows)
      list(FILTER ${side} EXCLUDE REGEX "^$")
      list(REMOVE_DUPLICATES ${side})
    endforeach()
    foreach(item IN LISTS linux)
      if(NOT item IN_LIST windows)
        list(APPEND differences "${target}: ${property} '${item}' missing on Windows")
      endif()
    endforeach()
    foreach(item IN LISTS windows)
      if(NOT item IN_LIST linux)
        list(APPEND differences "${target}: ${property} '${item}' missing on Linux")
      endif()
    endforeach()
  endforeach()
endforeach()

foreach(difference IN LISTS differences)
  message("${difference}")
endforeach()
if(differences)
  message(FATAL_ERROR "Edit cmake/windows-tests.cmake, then run experiments/render-stream/scripts/build-capture.sh --target windows")
endif()
if(audited EQUAL 0)
  message(FATAL_ERROR "no Windows test declarations were recorded from cmake/windows-tests.cmake.\nEdit cmake/windows-tests.cmake, then run experiments/render-stream/scripts/build-capture.sh --target windows")
endif()
message(STATUS "Windows test lists match Linux for ${audited} executable targets")
