set(GRC_LIBCXX_LLVM_MAJOR 20 CACHE STRING "LLVM major for the Linux libc++ control build")
find_program(GRC_LIBCXX_CC NAMES clang-${GRC_LIBCXX_LLVM_MAJOR})
find_program(GRC_LIBCXX_CXX NAMES clang++-${GRC_LIBCXX_LLVM_MAJOR})
if(NOT GRC_LIBCXX_CC OR NOT GRC_LIBCXX_CXX)
  message(FATAL_ERROR "Install clang-${GRC_LIBCXX_LLVM_MAJOR} libc++-${GRC_LIBCXX_LLVM_MAJOR}-dev libc++abi-${GRC_LIBCXX_LLVM_MAJOR}-dev")
endif()
set(CMAKE_C_COMPILER "${GRC_LIBCXX_CC}")
set(CMAKE_CXX_COMPILER "${GRC_LIBCXX_CXX}")
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-stdlib=libc++")
set(GRC_LINUX_LIBCXX ON CACHE BOOL "Linux libc++ control build")
