; Generated by CMake into the build directory with @GRC_LIBRARY_PATH_DESCRIPTION@.
; Load it with GDExtensionManager.load_extension(<absolute path to this file>).

[configuration]
entry_symbol = "grc_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
@GRC_LIBRARY_OS@.x86_64 = "@GRC_LIBRARY_PATH@"
