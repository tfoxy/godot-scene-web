; Gate 5 mesh fixture for the render-stream capture experiment (G5c). Ten steps (0..9) over
; persistent mutable meshes: an ArrayMesh in a MeshInstance2D, a raw mesh drawn once and changed by
; region updates, a two-surface mesh losing a surface, a geoclip-like deforming mesh updated every
; frame and recreated, a Polygon2D, a loaded ArrayMesh resource and a freed mesh still named by its
; item. See fixtures/gate5-mesh/README.md and ../../protocol/gate5-design.md ("Q6d") for the
; contract.

config_version=5

[application]

config/name="render-stream-gate5-mesh-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate5_mesh.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-4: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
