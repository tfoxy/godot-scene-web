; Gate -1 spike fixture for the render-stream capture experiment.
; See fixtures/spike/README.md for what this project proves and how it is run.

config_version=5

[application]

config/name="render-stream-gate-minus1-spike"
config/features=PackedStringArray("4.5")
run/main_scene="res://spike.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline (AGENTS.md "Languages and engine integration"): untyped declarations
; and unsafe dynamic access are errors, not warnings. `:=` type inference stays allowed (its
; warning, INFERRED_DECLARATION, is left at the engine default) because the repo prefers `:=`.
; There is no `debug/gdscript/warnings/treat_warnings_as_errors` key in 4.5.1 (checked
; modules/gdscript/gdscript.cpp and core/config/project_settings.cpp: no such setting is
; registered) — each warning is leveled individually instead, 2 == GDScriptWarning::ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
