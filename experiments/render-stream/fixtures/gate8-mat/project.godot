; Gate 8 material fixture (G8m, ../../protocol/gate8-design.md "Q5. Pre-arm materials and shaders"): one scene,
; mat.tscn, run two ways by the same loader autoload as gate8-adopt. `late` (the default main scene) is built
; before the capture arms at fixture frame K; `born` (res://born.tscn) instantiates the same scene
; in _ready after the capture armed in _enter_tree. See README.md.

config_version=5

[application]

config/name="render-stream-gate8-mat-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://mat.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as every gate fixture (fixtures/gate2/project.godot).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
textures/canvas_textures/default_texture_filter=0
