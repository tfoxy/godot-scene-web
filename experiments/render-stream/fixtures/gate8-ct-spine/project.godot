; Gate 8 late-arm spine CanvasTexture fixture (LATE-SPINE): 640x360, one 64x64 cell drawn by a
; custom Node2D whose _draw calls draw_mesh through a runtime CanvasTexture (no `texture` property,
; the spine-godot shape). The capture loads at fixture frame 8 and its arm is deferred to frame 14,
; after the CanvasTexture (frame 10) exists but before the arm: the capture adopts it from the
; canvas_texture_* hooks' registry. See README.md.

config_version=5

[application]

config/name="render-stream-gate8-ct-spine-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://spine.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as every gate fixture (fixtures/gate2/project.godot).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
textures/canvas_textures/default_texture_filter=0
