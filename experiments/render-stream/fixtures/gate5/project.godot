; Gate 5 fixture for the render-stream capture experiment: immediate geometry (G5b). Ten steps
; (0..9) over wide and thin lines, a dashed line, polylines with a miter corner and a hold-last
; colour list, concave, gradient and textured polygons, primitives, a raw triangle array with a
; count, circles, draw-transform commands, a clip-ignore span, raw nine-patches, an antialiased
; rect, a translucent polygon and a Line2D. See fixtures/gate5/README.md and
; ../../protocol/gate5-design.md ("Q6b") for the contract.

config_version=5

[application]

config/name="render-stream-gate5-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate5.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-4: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
