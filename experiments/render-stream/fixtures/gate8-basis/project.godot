; Gate 8 Basis fixture (G8ku, ../../protocol/texture-delivery-design.md D6, D12, D16): procedural
; textures created at runtime (RGBA8, RGB8, DXT1, L8, a mip chain, an updated one, a small one) and
; drawn 1:1, so a /9 basis-uastc capture offers lazy uastc variants exactly where D12 admits them.
; Nothing is imported or committed but code; see README.md.

config_version=5

[application]

config/name="render-stream-gate8-basis-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate8_basis.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as every gate fixture (fixtures/gate2/project.godot).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
textures/canvas_textures/default_texture_filter=0
