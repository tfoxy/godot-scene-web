; Gate 5 style fixture for the render-stream capture experiment: nine-patch and stylebox coverage
; (G5g). Ten steps (0..9) over NinePatchRect in stretch, tile, tile_fit and hollow, a
; StyleBoxTexture with modulate and expand margins, StyleBoxFlat sharp, bordered, rounded,
; shadowed and skewed, the default theme's Panel, a stylebox flipped by draw_set_transform (the
; TabBar pattern) and a focused RichTextLabel whose focus box sits between clip_ignore commands.
; See fixtures/gate5-style/README.md and ../../protocol/gate5-design.md ("Q6f") for the contract.

config_version=5

[application]

config/name="render-stream-gate5-style-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate5_style.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-4: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
