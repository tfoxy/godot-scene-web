; Gate 5.5 screen-texture fixture for the render-stream capture experiment (P3-ST). Six steps
; (0..5) over hint_screen_texture ShaderMaterials: the automatic back-buffer copy, a second reader
; reusing it, a mip-chain reader, and a fresh copy in a child CanvasLayer with a clipped reader.
; See fixtures/gate55-screen/README.md and ../../protocol/gate5_5-design.md
; ("Screen texture (P3-ST)").

config_version=5

[application]

config/name="render-stream-gate55-screen-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate55_screen.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-5: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
