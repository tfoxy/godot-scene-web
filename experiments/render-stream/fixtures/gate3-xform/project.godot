; Gate 3 rotated/scaled fixture for the render-stream capture experiment (G3c). Five steps (0..4)
; over clip_contents Controls under rotated, scaled and flipped Node2D parents: a rotated clip
; owner, a rotated owner nested in an axis-aligned one, half-pixel scissor rounding and a sub-pixel
; sliver, and a negative scale. The engine clips to the rounded bounding box (gate3-design.md Q1c).
; See fixtures/gate3-xform/README.md and ../../protocol/gate3-design.md ("Q6d") for the contract.

config_version=5

[application]

config/name="render-stream-gate3-xform-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate3x.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline (AGENTS.md "Languages and engine integration"): untyped declarations
; and unsafe dynamic access are errors, not warnings. `:=` type inference stays allowed (its
; warning, INFERRED_DECLARATION, is left at the engine default) because the repo prefers `:=`.
; There is no `debug/gdscript/warnings/treat_warnings_as_errors` key in 4.5.1 (see
; fixtures/spike/README.md "GDScript warning levels" for the source citations) -- each warning is
; leveled individually instead, 2 == GDScriptWarning::ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[gui]

; Q1e/Q6d: keep fractional Control positions unfloored (control.cpp:720-723 snaps the origin of a
; Control whose rotation is a multiple of 90 degrees while this is on, the default).
common/snap_controls_to_pixels=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
