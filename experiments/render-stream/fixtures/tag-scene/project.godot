; TAG1 fixture (client-extensions-design.md §6, ../../results/p3/tag1.md): Godot's own tagging
; (groups, metadata, instance scenes) on a scene whose nodes the capture resolves into item_meta
; rows, with its own oracle dump. See README.md.

config_version=5

[application]

config/name="render-stream-tag-scene-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://tag.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
