; Gate 8 texture fixture (G8t, ../../protocol/gate8-design.md "Q3. Compressed and float textures"):
; block-compressed textures imported by the pinned editor and drawn by sprites, a nine-patch and
; draw_texture_rect_region at nearest and linear filters, so the capture's host decode
; (GRC_TEXTURE_DECODE=engine) can be judged against the engine's own CPU decode. The sources are
; generated (make_sources.gd), never committed; see README.md.

config_version=5

[application]

config/name="render-stream-gate8-tex-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate8_tex.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as every gate fixture (fixtures/gate2/project.godot).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
textures/canvas_textures/default_texture_filter=0
; Both desktop (S3TC/BPTC) and mobile (ETC2/ASTC) variants of every VRAM-compressed import, so one
; fixture covers the formats the STS2 census holds and the ones the g31 can sample
; (gate8-design.md Q1d); CPU encoders only, so the import is the same on every host.
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/compress_with_gpu=false
