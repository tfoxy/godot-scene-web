; Gate 5.5 vertex() fixture for the render-stream capture experiment (P3-VX). Five steps (0..4)
; over canvas_item ShaderMaterials with a vertex() function or a vertex render mode: varyings
; (smooth, flat, int), VERTEX and UV in vertex(), skip_vertex_transform, world_vertex_coords, and
; MODEL/CANVAS/SCREEN_MATRIX under a scaled child CanvasLayer. See fixtures/gate55-vertex/README.md
; and ../../protocol/gate5_5-design.md ("vertex() (P3-VX)").

config_version=5

[application]

config/name="render-stream-gate55-vertex-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate55_vertex.tscn"

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-5: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
