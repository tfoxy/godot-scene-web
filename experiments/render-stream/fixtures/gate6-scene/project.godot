; Gate 6 combined scene for the render-stream capture experiment (G6a). One 640x360 scene of native
; Controls, a clipped ScrollContainer, text, a custom _draw, a texture that changes and is freed, a
; mesh deformed every frame, a CanvasItemMaterial, a ShaderMaterial driven by an AnimationPlayer, a
; Tween, a top_level escape and a HUD CanvasLayer, over twelve frame-indexed steps (0..11).
; Variants `animate` and `refused`. See fixtures/gate6-scene/README.md and
; ../../protocol/gate6-design.md ("Q6") for the contract.

config_version=5

[application]

config/name="render-stream-gate6-scene-fixture"
config/features=PackedStringArray("4.5")
run/main_scene="res://gate6_scene.tscn"
run/low_processor_mode_sleep_usec=0

[autoload]

GrcLoader="*res://loader.gd"

[debug]

; Typed-GDScript discipline, as gates 0-5.5: each warning leveled individually, 2 == ERROR.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[gui]

theme/custom=""
theme/custom_font=""
theme/default_theme_scale=1.0
theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=0
theme/default_font_multichannel_signed_distance_field=false
theme/default_font_generate_mipmaps=false
theme/lcd_subpixel_layout=1
common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.2, 0.2, 0.4, 1)
