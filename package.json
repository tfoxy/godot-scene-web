{
  "name": "godot-scene-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @godot-scene-web/playground dev",
    "format": "biome check --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome check . && prettier --check \"**/*.{md,yml,yaml}\"",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:parser": "vitest run packages/tscn-parser",
    "test:layout": "vitest run packages/layout",
    "test:parity": "vitest run packages/test-harness/test && pnpm parity:fixture -- --all",
    "test:default-font-parity": "tsx --conditions=development scripts/default-font-parity.ts",
    "test:webgpu-composite": "xvfb-run -a vitest run packages/test-harness/test/webgpuCompositeXvfb.test.ts",
    "test:webgl-composite": "xvfb-run -a vitest run packages/test-harness/test/webglCompositeXvfb.test.ts",
    "test:canvas-pixel": "xvfb-run -a vitest run packages/test-harness/test/canvasPixelXvfb.test.ts",
    "test:canvas-glyph-pixel": "GSW_CANVAS_GLYPH_PIXEL=1 xvfb-run -a vitest run packages/test-harness/test/canvasGlyphPixelXvfb.test.ts",
    "test:glyph-pixel": "GSW_HB_GPU_PIXEL=1 xvfb-run -a vitest run packages/hb-gpu/test/glyphPixelXvfb.test.ts",
    "bench:canvas-upload": "GSW_CANVAS_UPLOAD_BENCH=1 xvfb-run -a vitest run packages/test-harness/test/canvasUploadBenchXvfb.test.ts --disable-console-intercept",
    "parity:fixture": "tsx --conditions=development packages/test-harness/src/cli.ts",
    "perf": "tsx --conditions=development packages/perf-harness/src/cli.ts",
    "godot:text-bench": "tsx --conditions=development packages/perf-harness/src/godot-text-bench.ts",
    "godot:outline-ref": "tsx --conditions=development scripts/godot-outline-ref.ts",
    "godot:text-crossover": "tsx --conditions=development scripts/godot-text-crossover.ts",
    "text:fidelity": "tsx --conditions=development packages/perf-harness/probes/text-fidelity.ts",
    "text:crossover": "tsx --conditions=development packages/perf-harness/probes/text-crossover.ts",
    "text:report": "tsx --conditions=development packages/perf-harness/src/text-report.ts",
    "release:check-tag": "tsx scripts/validate-release-tag.ts",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "harfbuzzjs": "1.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8",
    "esbuild": "^0.28.0"
  }
}
