{
  "name": "@godot-scene-web/vue",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Vue 3 components for godot-scene-web HTML scenes.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfoxy/godot-scene-web.git"
  },
  "homepage": "https://github.com/tfoxy/godot-scene-web#readme",
  "bugs": {
    "url": "https://github.com/tfoxy/godot-scene-web/issues"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/vue/test"
  },
  "dependencies": {
    "@godot-scene-web/core": "workspace:*",
    "@godot-scene-web/html": "workspace:*",
    "@godot-scene-web/layout": "workspace:*",
    "@godot-scene-web/scene-graph": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.34"
  }
}
