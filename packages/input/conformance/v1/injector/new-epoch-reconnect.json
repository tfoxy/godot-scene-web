{
  "name": "new-epoch-reconnect",
  "description": "A reconnect (new epoch on a new channel) releases the old epoch's state and unbinds the old channel; the source keeps its devices.",
  "config": {},
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 100
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 100,
        "seq": 1,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          },
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 200
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 100,
        "seq": 2,
        "events": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          }
        ]
      },
      "result": "no-hello"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 100,
        "seq": 1,
        "events": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          }
        ]
      },
      "channel": "b",
      "result": "stale-epoch"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 200
      },
      "channel": "b",
      "result": "duplicate"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 200,
        "seq": 1,
        "events": [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ]
      },
      "channel": "b"
    },
    {
      "close": "a"
    },
    {
      "close": "b"
    }
  ],
  "expect": [
    {
      "after": 1,
      "physical_keys": [87],
      "keys": [87],
      "labels": [87],
      "actions": ["gsw_test_jump"],
      "joy_buttons": [[64, 0]],
      "dispatched": ["key 87/87/87 down", "joy_button 64 0 down"],
      "joypads": [64],
      "joypad_signals": ["attached 64 a 0"]
    },
    {
      "after": 2,
      "dispatched": ["key 87/87/87 up", "joy_button 64 0 up"],
      "joypads": [64]
    },
    {
      "after": 5,
      "dispatched": [],
      "stats": {
        "no-hello": 1,
        "stale-epoch": 1,
        "duplicate": 1
      },
      "joypads": [64]
    },
    {
      "after": 6,
      "joy_buttons": [[64, 0]],
      "actions": ["gsw_test_jump"],
      "dispatched": ["joy_button 64 0 down"],
      "stats": {
        "no-hello": 1,
        "stale-epoch": 1,
        "duplicate": 1
      },
      "joypads": [64]
    },
    {
      "after": 7,
      "joy_buttons": [[64, 0]],
      "actions": ["gsw_test_jump"],
      "dispatched": [],
      "stats": {
        "no-hello": 1,
        "stale-epoch": 1,
        "duplicate": 1
      },
      "joypads": [64]
    },
    {
      "after": 8,
      "dispatched": ["joy_button 64 0 up"],
      "stats": {
        "no-hello": 1,
        "stale-epoch": 1,
        "duplicate": 1
      },
      "joypads": [64]
    }
  ]
}
