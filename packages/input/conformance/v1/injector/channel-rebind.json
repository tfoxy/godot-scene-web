{
  "name": "channel-rebind",
  "description": "A hello for another source on a bound channel closes the channel's previous source first.",
  "config": {},
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 2
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          }
        ]
      },
      "result": "stale-epoch"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 2,
        "seq": 1,
        "events": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          }
        ]
      }
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 1,
      "physical_keys": [87],
      "keys": [87],
      "labels": [87],
      "actions": ["gsw_test_jump"],
      "dispatched": ["key 87/87/87 down"]
    },
    {
      "after": 2,
      "dispatched": ["key 87/87/87 up"]
    },
    {
      "after": 4,
      "physical_keys": [83],
      "keys": [83],
      "labels": [83],
      "dispatched": ["key 83/83/83 down"],
      "stats": {
        "stale-epoch": 1
      }
    },
    {
      "after": 5,
      "dispatched": ["key 83/83/83 up"],
      "stats": {
        "stale-epoch": 1
      }
    }
  ]
}
