{
  "name": "pointer-devices-leased",
  "description": "Mouse and touch events carry the first id of the source's leased device block, taken on first use without attaching a pad (its pad slot 0 later attaches on the same id); a closed source keeps block and touch range until its lease ends, then a new source reuses block 0 (device 64) and touch range 0.",
  "config": {
    "lease_ms": 1000
  },
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_motion",
            "position": [10, 10]
          }
        ]
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "joypad_button",
            "button_index": 0,
            "pressed": true
          },
          {
            "event": "joypad_button",
            "button_index": 0,
            "pressed": false
          }
        ]
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 1
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_motion",
            "position": [50, 50]
          },
          {
            "event": "screen_touch",
            "index": 0,
            "pressed": true,
            "position": [60, 60]
          }
        ]
      },
      "channel": "b"
    },
    {
      "close": "a"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "c",
        "epoch": 1
      },
      "channel": "c",
      "at": 2000
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "screen_touch",
            "index": 0,
            "pressed": true,
            "position": [5, 5]
          },
          {
            "event": "mouse_motion",
            "position": [6, 6]
          }
        ]
      },
      "channel": "c",
      "at": 2000
    },
    {
      "close": "b"
    },
    {
      "close": "c"
    }
  ],
  "expect": [
    {
      "after": 1,
      "mouse_mask": 0,
      "mouse_position": [10, 10],
      "dispatched": ["mouse_motion 64 10.00,10.00 rel=0.00,0.00 mask=0"]
    },
    {
      "after": 2,
      "mouse_mask": 0,
      "mouse_position": [10, 10],
      "joypads": [64],
      "joypad_signals": ["attached 64 a 0"],
      "dispatched": ["joy_button 64 0 down", "joy_button 64 0 up"]
    },
    {
      "after": 4,
      "mouse_mask": 1,
      "mouse_position": [60, 60],
      "joypads": [64],
      "dispatched": [
        "mouse_button -1 1 down 60.00,60.00 mask=1",
        "screen_touch 68 32 down 60.00,60.00"
      ],
      "stats": {
        "mouse-not-owner": 1
      }
    },
    {
      "after": 5,
      "mouse_mask": 1,
      "mouse_position": [60, 60],
      "joypads": [64],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 1
      }
    },
    {
      "after": 6,
      "mouse_mask": 1,
      "mouse_position": [60, 60],
      "joypad_signals": ["detached 64 a 0"],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 1
      }
    },
    {
      "after": 7,
      "mouse_mask": 1,
      "mouse_position": [6, 6],
      "dispatched": [
        "screen_touch 64 0 down 5.00,5.00",
        "mouse_motion 64 6.00,6.00 rel=0.00,0.00 mask=0"
      ],
      "stats": {
        "mouse-not-owner": 1
      }
    },
    {
      "after": 8,
      "mouse_mask": 0,
      "mouse_position": [60, 60],
      "dispatched": [
        "mouse_button -1 1 up 60.00,60.00 mask=0 canceled",
        "screen_touch 68 32 up 60.00,60.00 canceled"
      ],
      "stats": {
        "mouse-not-owner": 1
      }
    },
    {
      "after": 9,
      "mouse_mask": 0,
      "mouse_position": [60, 60],
      "dispatched": ["screen_touch 64 0 up 5.00,5.00 canceled"],
      "stats": {
        "mouse-not-owner": 1
      }
    }
  ]
}
