{
  "name": "gates-and-rejects",
  "description": "accept_kinds, allowed_actions and device range gate single records; codec rejects drop the whole message atomically and keep the seq; unknown types are ignored.",
  "config": {
    "accept_kinds": [
      "key",
      "joypad_button",
      "joypad_motion",
      "mouse_button",
      "action"
    ],
    "allowed_actions": ["gsw_test_jump"]
  },
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 7
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 1,
        "events": [
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [10, 10]
          },
          {
            "event": "magnify_gesture",
            "position": [10, 10],
            "factor": 1.5
          },
          {
            "event": "action",
            "action": "ui_accept",
            "pressed": true
          },
          {
            "event": "action",
            "action": "gsw_test_jump",
            "pressed": true
          },
          {
            "event": "screen_touch",
            "pressed": true,
            "position": [10, 10]
          },
          {
            "event": "midi"
          },
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 2,
        "events": [
          {
            "event": "target",
            "handle": 3,
            "path": "Main/Button"
          },
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [10, 10],
            "target": 3,
            "local": [1, 2]
          },
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": false,
            "position": [10, 10],
            "target": 9,
            "local": [1, 2]
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 3,
        "events": [
          {
            "event": "joypad_button",
            "device": 4,
            "button_index": 0,
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 4,
        "events": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          },
          {
            "event": "key",
            "physical_keycode": 68,
            "pressed": "yes"
          }
        ]
      },
      "result": "bad-field"
    },
    {
      "recv": "{\"type\":\"status\",\"epoch\":7,\"seq\":4}",
      "result": "unknown-type"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 4,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": false
          }
        ]
      }
    },
    {
      "recv": "{\"type\":\"heartbeat\",\"epoch\":7,\"seq\":5,\"pad\":\"\"}",
      "result": "too-large"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/2",
        "source": "c",
        "epoch": 3
      },
      "channel": "c",
      "result": "unsupported-format"
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 1,
      "physical_keys": [87],
      "keys": [87],
      "labels": [87],
      "actions": ["gsw_test_jump"],
