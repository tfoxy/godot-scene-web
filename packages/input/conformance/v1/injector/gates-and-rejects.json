    },
    {
      "after": 8,
      "dispatched": ["key 87/87/87 up"],
      "stats": {
        "kind-unsupported": 4,
        "kind-refused": 2,
        "action-refused": 1,
        "skipped": 1,
        "undeclared-target": 1,
        "device-refused": 1,
        "bad-field": 1,
        "unknown-type": 1,
        "too-large": 1,
        "unsupported-format": 1
