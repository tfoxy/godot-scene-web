      "dispatched": []
    },
    {
      "after": 9,
      "joy_axes": [[64, 0, 0.9]],
      "actions": ["gsw_test_right"],
      "dispatched": ["joy_motion 64 0 0.9000"]
    },
    {
      "after": 10,
      "joy_axes": [[64, 0, 0.3]],
      "dispatched": ["joy_motion 64 0 0.3000"]
    },
    {
      "after": 11,
      "joy_axes": [[64, 0, 0.9]],
      "actions": ["gsw_test_right"],
      "dispatched": ["joy_motion 64 0 0.9000"]
    },
    {
      "after": 12,
      "dispatched": ["joy_motion 64 0 0.0000"]
    }
  ]
