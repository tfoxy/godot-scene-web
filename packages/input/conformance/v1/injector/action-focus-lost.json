{
  "name": "action-focus-lost",
  "description": "Focus loss releases actions in Godot (release_pressed_events releases every action) without an event: the injector moves held actions aside, a later release of one sends nothing, a fresh press presses again, and reassert() presses it again at its strength.",
  "config": {
    "accept_kinds": ["key", "action"],
    "allowed_actions": ["gsw_test_jump"]
  },
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "action",
            "action": "gsw_test_jump",
            "pressed": true,
            "strength": 0.5
          }
        ]
      }
    },
    {
      "focus_lost": true
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "action",
            "action": "gsw_test_jump",
            "pressed": false
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 3,
        "events": [
          {
            "event": "action",
            "action": "gsw_test_jump",
            "pressed": true
          }
        ]
      }
    },
    {
      "focus_lost": true
    },
    {
      "reassert": true
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 1,
      "actions": ["gsw_test_jump"],
      "mouse_mask": 0,
      "dispatched": ["action gsw_test_jump down 0.50"]
    },
    {
      "after": 2,
      "mouse_mask": 0,
      "dispatched": []
    },
    {
      "after": 3,
      "mouse_mask": 0,
      "dispatched": []
    },
    {
      "after": 4,
      "actions": ["gsw_test_jump"],
      "mouse_mask": 0,
      "dispatched": ["action gsw_test_jump down 1.00"]
    },
    {
      "after": 5,
      "mouse_mask": 0,
      "dispatched": []
    },
    {
      "after": 6,
      "actions": ["gsw_test_jump"],
      "mouse_mask": 0,
      "dispatched": ["action gsw_test_jump down 1.00"]
    },
    {
      "after": 7,
      "mouse_mask": 0,
      "dispatched": ["action gsw_test_jump up 0.00"]
    }
  ]
}
