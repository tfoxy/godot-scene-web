{
  "name": "pointer-mouse-owner-first",
  "description": "mouse_owner first: the first source to send a mouse record keeps the mouse through reset (which releases its buttons) until bye; only then can another source claim it. Pointer devices are the first id of each source's leased block, taken on first use (b's press comes first, so b is 64).",
  "config": {
    "mouse_owner": "first"
  },
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 1
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [30, 30],
            "button_mask": 1
          }
        ]
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [10, 10],
            "button_mask": 1
          },
          {
            "event": "mouse_motion",
            "position": [10, 10],
            "button_mask": 1
          }
        ]
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "reset",
        "epoch": 1,
        "seq": 2
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "mouse_motion",
            "position": [11, 10]
          }
        ]
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "bye",
        "epoch": 1,
        "seq": 3
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 3,
        "events": [
          {
            "event": "mouse_motion",
            "position": [12, 10]
          }
        ]
      },
      "channel": "a"
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 2,
      "mouse_mask": 1,
      "mouse_position": [30, 30],
      "dispatched": ["mouse_button 64 1 down 30.00,30.00 mask=1"]
    },
    {
      "after": 3,
      "mouse_mask": 1,
      "mouse_position": [30, 30],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 2
      }
    },
    {
      "after": 4,
      "mouse_mask": 0,
      "mouse_position": [30, 30],
      "dispatched": ["mouse_button 64 1 up 30.00,30.00 mask=0 canceled"],
      "stats": {
        "mouse-not-owner": 2
      }
    },
    {
      "after": 5,
      "mouse_mask": 0,
      "mouse_position": [30, 30],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 3
      }
    },
    {
      "after": 6,
      "mouse_mask": 0,
      "mouse_position": [30, 30],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 3
      }
    },
    {
      "after": 7,
      "mouse_mask": 0,
      "mouse_position": [12, 10],
      "dispatched": ["mouse_motion 68 12.00,10.00 rel=0.00,0.00 mask=0"],
      "stats": {
        "mouse-not-owner": 3
      }
    }
  ]
}
