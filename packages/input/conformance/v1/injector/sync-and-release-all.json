{
  "name": "sync-and-release-all",
  "description": "A sync presses what it lists and releases what it does not, per scope; release_all() releases every source and keeps sessions open. A keyboard-only source takes no device block, so b's pad 0 is device 64.",
  "config": {},
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      }
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 2
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "sync",
        "epoch": 1,
        "seq": 1,
        "scope": "keyboard",
        "held": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          },
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "sync",
        "epoch": 2,
        "seq": 1,
        "scope": "joypad",
        "device": 0,
        "held": [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": 0.75
          }
        ]
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "sync",
        "epoch": 1,
        "seq": 2,
        "scope": "keyboard",
        "held": [
          {
            "event": "key",
            "physical_keycode": 83,
            "keycode": 83,
            "key_label": 83,
            "unicode": 115,
            "code": "KeyS",
            "pressed": true
          },
          {
            "event": "key",
            "physical_keycode": 68,
            "keycode": 68,
            "key_label": 68,
            "unicode": 100,
            "code": "KeyD",
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "sync",
        "epoch": 2,
        "seq": 2,
        "scope": "joypad",
        "device": 0,
        "held": [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 1,
            "pressed": true
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 1,
            "axis_value": -0.5
          }
        ]
      },
      "channel": "b"
    },
    {
      "release_all": true
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 3,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          }
        ]
      }
    },
    {
      "close": "a"
    },
    {
      "close": "b"
    }
  ],
  "expect": [
    {
      "after": 2,
      "physical_keys": [83, 87],
      "keys": [83, 87],
      "labels": [83, 87],
      "actions": ["gsw_test_jump"],
      "dispatched": ["key 87/87/87 down", "key 83/83/83 down"]
    },
    {
      "after": 3,
      "physical_keys": [83, 87],
      "keys": [83, 87],
      "labels": [83, 87],
      "joy_buttons": [[64, 0]],
      "joy_axes": [[64, 0, 0.75]],
      "actions": ["gsw_test_jump", "gsw_test_right"],
      "dispatched": ["joy_button 64 0 down", "joy_motion 64 0 0.7500"],
      "joypads": [64],
      "joypad_signals": ["attached 64 b 0"]
    },
    {
      "after": 4,
      "physical_keys": [68, 83],
      "keys": [68, 83],
      "labels": [68, 83],
      "joy_buttons": [[64, 0]],
      "joy_axes": [[64, 0, 0.75]],
      "actions": ["gsw_test_jump", "gsw_test_right"],
      "dispatched": ["key 87/87/87 up", "key 68/68/68 down"],
      "joypads": [64]
    },
    {
      "after": 5,
      "physical_keys": [68, 83],
      "keys": [68, 83],
      "labels": [68, 83],
      "joy_buttons": [[64, 1]],
      "joy_axes": [[64, 1, -0.5]],
      "dispatched": [
        "joy_button 64 0 up",
        "joy_motion 64 0 0.0000",
        "joy_button 64 1 down",
        "joy_motion 64 1 -0.5000"
      ],
      "joypads": [64]
    },
    {
      "after": 6,
      "dispatched": [
        "key 83/83/83 up",
        "key 68/68/68 up",
        "joy_button 64 1 up",
        "joy_motion 64 1 0.0000"
      ],
      "joypads": [64]
    },
    {
      "after": 7,
      "physical_keys": [87],
      "keys": [87],
      "labels": [87],
      "actions": ["gsw_test_jump"],
      "dispatched": ["key 87/87/87 down"],
      "joypads": [64]
    },
    {
      "after": 9,
      "dispatched": ["key 87/87/87 up"],
      "joypads": [64]
    }
  ]
}
