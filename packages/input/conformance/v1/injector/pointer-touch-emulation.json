{
  "name": "pointer-touch-emulation",
  "description": "Touches never get a mouse twin from the injector: Godot's emulate_mouse_from_touch turns only the first active touch into exactly one LEFT press (device -1), its drag into motion and its release into the release; a second finger is never emulated; close cancels the active touch.",
  "config": {},
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "screen_touch",
            "index": 0,
            "pressed": true,
            "position": [40, 50]
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "screen_drag",
            "index": 0,
            "position": [44, 52],
            "relative": [4, 2],
            "pressure": 0.5
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 3,
        "events": [
          {
            "event": "screen_touch",
            "index": 1,
            "pressed": true,
            "position": [60, 60]
          },
          {
            "event": "screen_drag",
            "index": 1,
            "position": [61, 60],
            "relative": [1, 0]
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 4,
        "events": [
          {
            "event": "screen_touch",
            "index": 0,
            "pressed": false,
            "position": [45, 52]
          },
          {
            "event": "screen_drag",
            "index": 0,
            "position": [46, 52],
            "relative": [1, 0]
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 5,
        "events": [
          {
            "event": "screen_touch",
            "index": 1,
            "pressed": false,
            "position": [61, 60]
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 6,
        "events": [
          {
            "event": "screen_touch",
            "index": 2,
            "pressed": true,
            "position": [10, 10],
            "double_tap": true
          }
        ]
      }
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 1,
      "mouse_mask": 1,
      "mouse_position": [40, 50],
      "dispatched": [
        "mouse_button -1 1 down 40.00,50.00 mask=1",
        "screen_touch 64 0 down 40.00,50.00"
      ]
    },
    {
      "after": 2,
      "mouse_mask": 1,
      "mouse_position": [44, 52],
      "dispatched": [
        "mouse_motion -1 44.00,52.00 rel=4.00,2.00 mask=1 pressure=0.50",
        "screen_drag 64 0 44.00,52.00 rel=4.00,2.00 pressure=0.50"
      ]
    },
    {
      "after": 3,
      "mouse_mask": 1,
      "mouse_position": [44, 52],
      "dispatched": [
        "screen_touch 64 1 down 60.00,60.00",
        "screen_drag 64 1 61.00,60.00 rel=1.00,0.00"
      ]
    },
    {
      "after": 4,
      "mouse_mask": 0,
      "mouse_position": [45, 52],
      "dispatched": [
        "mouse_button -1 1 up 45.00,52.00 mask=0",
        "screen_touch 64 0 up 45.00,52.00"
      ],
      "stats": {
        "unheld": 1
      }
    },
    {
      "after": 5,
      "mouse_mask": 0,
      "mouse_position": [45, 52],
      "dispatched": ["screen_touch 64 1 up 61.00,60.00"],
      "stats": {
        "unheld": 1
      }
    },
    {
      "after": 6,
      "mouse_mask": 1,
      "mouse_position": [10, 10],
      "dispatched": [
        "mouse_button -1 1 down 10.00,10.00 mask=1 double",
        "screen_touch 64 2 down 10.00,10.00 double"
      ],
      "stats": {
        "unheld": 1
      }
    },
    {
      "after": 7,
      "mouse_mask": 0,
      "mouse_position": [10, 10],
      "dispatched": [
        "mouse_button -1 1 up 10.00,10.00 mask=0 canceled",
        "screen_touch 64 2 up 10.00,10.00 canceled"
      ],
      "stats": {
        "unheld": 1
      }
    }
  ]
}
