{
  "name": "pointer-mouse-owner-fixed",
  "description": "mouse_owner set to a source id: only that source drives the mouse, before and after it closes; every other source's mouse records are dropped (touches are not affected).",
  "config": {
    "mouse_owner": "b"
  },
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 1
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 1
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_motion",
            "position": [5, 5]
          },
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [5, 5],
            "button_mask": 1
          },
          {
            "event": "screen_touch",
            "index": 0,
            "pressed": true,
            "position": [6, 6]
          }
        ]
      },
      "channel": "a"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_motion",
            "position": [40, 40]
          }
        ]
      },
      "channel": "b"
    },
    {
      "close": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 2,
        "events": [
          {
            "event": "mouse_button",
            "button_index": 1,
            "pressed": true,
            "position": [5, 5],
            "button_mask": 1
          }
        ]
      },
      "channel": "a"
    },
    {
      "close": "a"
    }
  ],
  "expect": [
    {
      "after": 2,
      "mouse_mask": 1,
      "mouse_position": [6, 6],
      "dispatched": [
        "mouse_button -1 1 down 6.00,6.00 mask=1",
        "screen_touch 64 0 down 6.00,6.00"
      ],
      "stats": {
        "mouse-not-owner": 2
      }
    },
    {
      "after": 3,
      "mouse_mask": 1,
      "mouse_position": [40, 40],
      "dispatched": ["mouse_motion 68 40.00,40.00 rel=0.00,0.00 mask=0"],
      "stats": {
        "mouse-not-owner": 2
      }
    },
    {
      "after": 5,
      "mouse_mask": 1,
      "mouse_position": [40, 40],
      "dispatched": [],
      "stats": {
        "mouse-not-owner": 3
      }
    },
    {
      "after": 6,
      "mouse_mask": 0,
      "mouse_position": [6, 6],
      "dispatched": [
        "mouse_button -1 1 up 6.00,6.00 mask=0 canceled",
        "screen_touch 64 0 up 6.00,6.00 canceled"
      ],
      "stats": {
        "mouse-not-owner": 3
      }
    }
  ]
}
