            "event": "screen_touch",
            "index": 0,
            "pressed": true,
            "position": [70, 70]
          }
        ]
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 4,
        "events": [
          {
            "event": "mouse_button",
            "button_index": 2,
            "pressed": false,
            "position": [50, 50]
          }
        ]
      },
      "channel": "b"
    },
    {
      "close": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 5,
        "events": [
          {
            "event": "mouse_motion",
            "position": [20, 20]
          }
        ]
      },
      "channel": "a"
