        "type": "hello",
        "format": "gsw-input/1",
        "source": "b",
        "epoch": 1
      },
      "channel": "b"
    },
    {
      "recv": {
        "type": "events",
        "epoch": 1,
        "seq": 1,
        "events": [
          {
            "event": "mouse_motion",
            "position": [10, 10]
          }
