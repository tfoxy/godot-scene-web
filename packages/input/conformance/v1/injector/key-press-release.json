{
  "name": "key-press-release",
  "description": "A key press reaches all three Input key sets and its action; the release clears them.",
  "config": {},
  "steps": [
    {
      "recv": {
        "type": "hello",
        "format": "gsw-input/1",
        "source": "a",
        "epoch": 7
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 1,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": true
          }
        ]
      }
    },
    {
      "recv": {
        "type": "events",
        "epoch": 7,
        "seq": 2,
        "events": [
          {
            "event": "key",
            "physical_keycode": 87,
            "keycode": 87,
            "key_label": 87,
            "unicode": 119,
            "code": "KeyW",
            "pressed": false
          }
        ]
      }
    }
  ],
  "expect": [
    {
      "after": 1,
      "physical_keys": [87],
      "keys": [87],
      "labels": [87],
      "actions": ["gsw_test_jump"],
      "dispatched": ["key 87/87/87 down"]
    },
    {
      "after": 2,
      "dispatched": ["key 87/87/87 up"]
    }
  ]
}
