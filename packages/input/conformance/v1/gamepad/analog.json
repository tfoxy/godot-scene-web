    {
      "name": "out-of-range sticks clamp to -1..1 and triggers to 0..1",
      "frames": [
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [
                0,
                0,
                0,
                0,
                0,
                0,
                {
                  "value": 1.2
                },
                {
                  "value": -0.5
                }
