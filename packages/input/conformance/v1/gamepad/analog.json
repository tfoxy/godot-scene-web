{
  "description": "Analog policy: rest floor 0.02, 1/256 quanta with <= 4 decimals, changed axes only, maxHz.",
  "vectors": [
    {
      "name": "values below the 0.02 rest floor read 0",
      "frames": [
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [],
              "axes": [0.019, -0.01, 0.02, -0.02]
            }
          ]
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [],
              "axes": [0.015, 0, 0.01, -0.02]
            }
          ]
        }
      ],
      "options": {
        "pads": "each"
      },
      "expect": [
        [
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 2,
            "axis_value": 0.0195
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 3,
            "axis_value": -0.0195
          }
        ],
        [
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 2,
            "axis_value": 0
          }
        ]
      ]
    },
