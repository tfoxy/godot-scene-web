          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ],
        [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": false
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": 0
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 5,
            "axis_value": 0
          }
        ],
        []
      ]
    },
    {
      "name": "a hidden tab releases; visible again presses what is still held",
      "frames": [
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": [-1]
            }
          ]
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": [-1]
            }
          ],
          "visibility": "hidden"
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": [-1]
            }
          ],
          "visibility": "hidden"
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": [-1]
            }
          ],
          "visibility": "visible"
        }
      ],
      "options": {
        "pads": "each"
      },
      "expect": [
        [
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": -1
