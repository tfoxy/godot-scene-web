          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ],
        [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": false
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": 0
          }
        ],
        [],
        [
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": -1
          },
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ]
      ]
    },
    {
      "name": "dispose releases what is held and stops",
      "frames": [
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": []
            }
          ]
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": []
            }
          ],
          "dispose": true
        },
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [1],
              "axes": []
            }
          ]
        }
      ],
      "options": {
        "pads": "each"
      },
      "expect": [
        [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": true
          }
        ],
        [
          {
            "event": "joypad_button",
            "device": 0,
            "button_index": 0,
            "pressed": false
          }
