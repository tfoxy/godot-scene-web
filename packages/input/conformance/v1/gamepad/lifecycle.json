{
  "description": "Disconnect, hidden tab and dispose release held state.",
  "vectors": [
    {
      "name": "a disconnect releases its buttons and zeroes its axes",
      "frames": [
        {
          "pads": [
            {
              "mapping": "standard",
              "buttons": [
                1,
                0,
                0,
                0,
                0,
                0,
                0,
                {
                  "value": 0.5
                }
              ],
              "axes": [0.5]
            }
          ]
        },
        {
          "pads": []
        },
        {
          "pads": []
        }
      ],
      "options": {
        "pads": "each"
      },
      "expect": [
        [
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 0,
            "axis_value": 0.5
          },
          {
            "event": "joypad_motion",
            "device": 0,
            "axis": 5,
            "axis_value": 0.5
