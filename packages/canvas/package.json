{
  "name": "@godot-scene-web/canvas",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "GPU canvas renderer for Godot CanvasItem draw lists.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfoxy/godot-scene-web.git"
  },
  "homepage": "https://github.com/tfoxy/godot-scene-web#readme",
  "bugs": {
    "url": "https://github.com/tfoxy/godot-scene-web/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./glyphs": {
      "development": "./src/glyph-pass-hbgpu.ts",
      "types": "./dist/glyph-pass-hbgpu.d.ts",
      "import": "./dist/glyph-pass-hbgpu.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/canvas/test"
  },
  "dependencies": {
    "@godot-scene-web/canvas-effects": "workspace:*",
    "@godot-scene-web/core": "workspace:*",
    "@godot-scene-web/effects": "workspace:*",
    "@godot-scene-web/hb-gpu": "workspace:*"
  }
}
